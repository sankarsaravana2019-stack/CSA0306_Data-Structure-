#include <stdio.h>

#define INF 9999

int main() {
    int cost[10][10], distance[10], visited[10];
    int n, i, j, start, count;
    int min, next;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter cost matrix:\n");
    printf("Enter 0 for no edge.\n");

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);

            if (cost[i][j] == 0 && i != j)
                cost[i][j] = INF;
        }
    }

    printf("Enter starting vertex: ");
    scanf("%d", &start);

    start--;

    for (i = 0; i < n; i++) {
        distance[i] = cost[start][i];
        visited[i] = 0;
    }

    distance[start] = 0;
    visited[start] = 1;

    for (count = 1; count < n; count++) {
        min = INF;
        next = -1;

        for (i = 0; i < n; i++) {
            if (!visited[i] && distance[i] < min) {
                min = distance[i];
                next = i;
            }
        }

        if (next == -1)
            break;

        visited[next] = 1;

        for (i = 0; i < n; i++) {
            if (!visited[i] &&
                distance[next] + cost[next][i] < distance[i]) {
                distance[i] = distance[next] + cost[next][i];
            }
        }
    }

    printf("\nShortest distances:\n");

    for (i = 0; i < n; i++)
        printf("From %d to %d = %d\n",
               start + 1, i + 1, distance[i]);

    return 0;
}
