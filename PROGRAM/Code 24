#include <stdio.h>

#define INF 9999

int main() {
    int cost[10][10], selected[10] = {0};
    int n, i, j, edges = 0;
    int min, x, y, total = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter cost matrix:\n");
    printf("Enter 0 for no edge.\n");

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);

            if (cost[i][j] == 0)
                cost[i][j] = INF;
        }
    }

    selected[0] = 1;

    printf("Edges in Minimum Spanning Tree:\n");

    while (edges < n - 1) {
        min = INF;
        x = -1;
        y = -1;

        for (i = 0; i < n; i++) {
            if (selected[i]) {
                for (j = 0; j < n; j++) {
                    if (!selected[j] && cost[i][j] < min) {
                        min = cost[i][j];
                        x = i;
                        y = j;
                    }
                }
            }
        }

        if (x == -1)
            break;

        printf("%d - %d : %d\n", x + 1, y + 1, min);

        total += min;
        selected[y] = 1;
        edges++;
    }

    printf("Minimum Cost = %d", total);

    return 0;
}
